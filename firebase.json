{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": {
    "source": ".output/server",
    "ignore": [
      "package-lock.json",
      "yarn.lock",
      "pnpm-lock.yaml",
      "firebase.json",
      "**/node_modules/**"
    ]
  },
  "hosting": {
    "public": ".output/public",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "run": {
          "serviceId": "server",
          "region": "us-central1"
        }
      }
    ]
  }
}
